<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launch theme of the entry activity: CLEAVE mark on the CLEAVE canvas, full screen. -->
    <style name="CLEAVE.SplashScreen" parent="MojoLauncher.AppTheme">
        <item name="android:windowBackground">@drawable/cleave_splash</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowDisablePreview">false</item>
    </style>

    <!-- Launcher host: CLEAVE canvas behind the Compose shell. System bars are driven at runtime by
         Tools.setInsetsMode() from LauncherActivity.setFullscreen() (CLEAVE "launcherFullScreen"). -->
    <style name="CLEAVE.Launcher" parent="MojoLauncher.AppTheme">
        <item name="android:windowBackground">@color/cleave_canvas</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
